{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // DOM.Iterable is what makes a NodeList spreadable. TypeScript 7 supplied
    // it implicitly; 5.x does not, and without it 74 call sites that iterate
    // query results stop compiling. It adds no runtime behaviour.
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["chrome", "node", "vitest/globals"]
  },
  "include": ["src", "tests", "scripts", "*.config.mjs", "*.config.ts"]
}
